# HKare Environment Variables
# Generated by Ansible

# Docker Hub Configuration
DOCKER_HUB_USERNAME={{ docker_hub_username }}

# Database Configuration
MYSQL_ROOT_PASSWORD={{ mysql_root_password }}
MYSQL_DATABASE={{ mysql_database }}
MYSQL_USER={{ mysql_user | default('hkare_user') }}
MYSQL_PASSWORD={{ mysql_password }}

# Application Configuration
SPRING_PROFILES_ACTIVE={{ spring_profiles_active | default('prod') }}
SERVER_PORT={{ backend_port }}

# Security Configuration
JWT_SECRET={{ jwt_secret | default('default_jwt_secret') }}
ENCRYPTION_KEY={{ encryption_key | default('default_encryption_key') }}

# Logging Configuration
LOG_LEVEL={{ log_level | default('INFO') }}

